  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "eslint": "^9.39.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.3",
    "@vitest/coverage-v8": "^4.0.13",
    "vitest": "^4.0.13"
  },
  "engines": {
    "node": ">=20"
